{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "only-for-candy",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/videos/*", "/__media-parts/*"]
  }
}
